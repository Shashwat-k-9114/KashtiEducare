# Copy this file to .env.local and fill in real values. .env.local is
# gitignored (see .gitignore's ".env*" pattern) — never commit real secrets.

# Real production domain — canonical URLs, sitemap.xml, robots.txt,
# llms.txt and OG/Twitter image URLs are all derived from this (see
# src/lib/seo.ts). Falls back to https://www.kashtieducare.com if unset.
NEXT_PUBLIC_SITE_URL=

# Optional search-console verification codes (see src/app/layout.tsx).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Deployment URL of the advisorIntake.gs Apps Script Web App (see
# scripts/google-apps-script/advisorIntake.gs and its deployment notes).
# Public/client-visible by design — this is an endpoint, not a secret —
# used by src/components/AdvisorIntakeForm.tsx to POST applications.
NEXT_PUBLIC_ADVISOR_FORM_ENDPOINT=

# Deployment URL of the enquiryForm.gs Apps Script Web App (see
# scripts/google-apps-script/enquiryForm.gs and its deployment notes).
# Public/client-visible by design — this is an endpoint, not a secret —
# used by src/components/ContactForm.tsx (the /contact enquiry form) to
# POST submissions.
NEXT_PUBLIC_ENQUIRY_FORM_ENDPOINT=

# --- /connect QR + links + analytics system ---------------------------

# Deployment URL of the connectSystem.gs Apps Script Web App (see
# scripts/google-apps-script/connectSystem.gs and its deployment notes).
# Server-only — unlike the two endpoints above, this one is NEVER sent to
# the browser (no NEXT_PUBLIC_ prefix): all reads/writes go through this
# site's own /api/connect/* and /api/admin/connect/* Route Handlers.
CONNECT_APPS_SCRIPT_URL=

# Shared secret gating every admin action on connectSystem.gs (link
# create/update/delete/reorder, stats, links_admin). Must exactly match
# the STATS_SECRET constant set in the deployed Apps Script. Generate a
# long random value, e.g. `openssl rand -hex 32`.
CONNECT_STATS_SECRET=

# Password for /admin/login (gates /admin/connect). Compared in constant
# time server-side — never logged, never sent to the client.
ADMIN_PASSWORD=

# HMAC signing key for the admin session cookie (src/lib/adminAuth.ts).
# Generate a long random value, e.g. `openssl rand -hex 32`. Changing
# this invalidates all existing admin sessions.
ADMIN_SESSION_SECRET=
