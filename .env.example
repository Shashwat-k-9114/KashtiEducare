# Copy this file to .env.local and fill in real values. .env.local is
# gitignored (see .gitignore's ".env*" pattern) — never commit real secrets.

# Production origin — canonical URLs, sitemap.xml, robots.txt, llms.txt,
# JSON-LD and OG/Twitter image URLs are all derived from this (see
# src/lib/seo.ts). Falls back to the non-www apex https://kashtieducare.com
# if unset. Must match Vercel's primary domain; leave blank in production
# unless a different origin is genuinely required.
NEXT_PUBLIC_SITE_URL=

# Optional search-console verification codes (see src/app/layout.tsx).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Deployment URL of the advisorIntake.gs Apps Script Web App (see
# scripts/google-apps-script/advisorIntake.gs and its deployment notes).
# Public/client-visible by design — this is an endpoint, not a secret —
# used by src/components/AdvisorIntakeForm.tsx to POST applications.
NEXT_PUBLIC_ADVISOR_FORM_ENDPOINT=

# Deployment URL of the enquiryForm.gs Apps Script Web App (see
# scripts/google-apps-script/enquiryForm.gs and its deployment notes).
# Public/client-visible by design — this is an endpoint, not a secret —
# used by src/components/ContactForm.tsx (the /contact enquiry form) to
# POST submissions.
NEXT_PUBLIC_ENQUIRY_FORM_ENDPOINT=

# Note: /connect is a fully static page — all its links live in
# src/data/connect.ts. It has no backend, database or env vars.
