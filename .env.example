# Copy to .env.local (local) and add the same two variables in Vercel -> Settings -> Environment Variables.
# URL of the deployed Apps Script web app (google-apps-script/Code.gs), ends in /exec
GOOGLE_SCRIPT_URL=
# Same value as the SECRET script property in Apps Script
GOOGLE_SCRIPT_SECRET=

# Admin portal (/admin). Choose a long password; the session secret must be 32+ random characters.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
